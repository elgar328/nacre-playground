{
  "name": "nacre-playground",
  "private": true,
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "wasm": "wasm-pack build ../wasm --release --target web --out-dir ../web/src/wasm/pkg",
    "wasm:dev": "wasm-pack build ../wasm --dev --target web --out-dir ../web/src/wasm/pkg",
    "wasm:test": "wasm-pack build ../wasm --dev --target nodejs --out-dir ../web/src/wasm/pkg-node",
    "wasm:all": "npm run wasm && npm run wasm:test",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "sucrase": "^3.35.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
